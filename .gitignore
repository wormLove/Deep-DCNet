.DS_Store
hpc/logs/*.out
hpc/logs/*.err
__pycache__/
*.pyc
*.pyo
DATA/
RESULT/
data/
outputs/
analysis_outputs/
*.pth
*.pt
*.csv
*.png
*.svg
*.log
.ipynb_checkpoints/
My_Notes_Aishani
Claude outputs/
gpu_rebuild_classifier/

# docs/prior_experiments/dc_net_hebbian_model/ keeps its own tracked RESULT
# logs + checkpoints (small, intentional - see its README.md). Un-ignore
# them here since the blanket RESULT/ and *.pt rules above would otherwise
# also match inside it.
!/docs/prior_experiments/dc_net_hebbian_model/RESULT/
!/docs/prior_experiments/dc_net_hebbian_model/RESULT/**
!/docs/prior_experiments/dc_net_hebbian_model/checkpoints/*.pt

# Top-level checkpoints/ (core/checkpointing.py's save_layer/load_layer) holds
# small, intentional, named reusable-layer checkpoints - not per-run junk.
# Un-ignore it here since the blanket *.pt rule above would otherwise also
# match inside it.
!/checkpoints/
!/checkpoints/*.pt
!/checkpoints/manifest.json
